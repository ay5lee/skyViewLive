FROM nginx:alpine

# Clear fixed Alpine package vulns (libxslt, zlib).
RUN apk update \
 && apk upgrade --no-cache libxslt zlib

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/html/index.html
COPY config.example.js /usr/share/nginx/html/config.example.js
COPY data/ /usr/share/nginx/html/data/

# Startup script writes config.js from GOOGLE_MAPS_KEY env var.
# Run as the nginx user (GroceryMate-style non-root / DS-0002).
RUN echo '#!/bin/sh' > /docker-entrypoint.d/40-config.sh \
 && echo 'echo "window.GOOGLE_MAPS_KEY = '"'"'${GOOGLE_MAPS_KEY}'"'"';" > /usr/share/nginx/html/config.js' >> /docker-entrypoint.d/40-config.sh \
 && chmod +x /docker-entrypoint.d/40-config.sh \
 && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
 && touch /var/run/nginx.pid \
 && chown nginx:nginx /var/run/nginx.pid \
 && sed -i 's|pid\s*/run/nginx.pid;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
 && sed -i 's|user\s\+nginx;|# user directive unused under USER nginx|' /etc/nginx/nginx.conf || true

USER nginx
